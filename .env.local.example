# Copy to .env.local — never commit .env.local
# ─────────────────────────────────────────────────────────────────────────────
# LLM Provider
# "openai"  → local dev / testing (default)
# "bedrock" → AWS production environment
# ─────────────────────────────────────────────────────────────────────────────
LLM_PROVIDER=openai

# Set to true to use fake AWS responses — no AWS credentials needed at all.
# Great for testing the agent logic end-to-end locally.
# The mock scenario: payment-service ECS tasks OOM-killing (exit 137),
# causing unhealthy ALB targets and elevated 5xx on API Gateway.
MOCK_AWS=false

# OpenAI — used when LLM_PROVIDER=openai
OPENAI_API_KEY=sk-
OPENAI_MODEL=gpt-4o

# Local UI origin. Use a comma-separated list if you run multiple local hosts.
CORS_ALLOW_ORIGINS=http://localhost:5173

# ─────────────────────────────────────────────────────────────────────────────
# AWS credentials — needed for the triage tools (read-only access to the
# account being triaged) regardless of LLM provider.
# Also needed for Bedrock InvokeModel when LLM_PROVIDER=bedrock.
# ─────────────────────────────────────────────────────────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=      # Uncomment and set only if using assumed-role / SSO
